# {{ ansible_managed }}
[DEFAULT]
bantime  = {{ fail2ban_bantime }}
findtime = {{ fail2ban_findtime }}
maxretry = {{ fail2ban_maxretry }}
ignoreip = 127.0.0.1/8 {{ fail2ban_ignoreip | join(' ') }}
# Bans are inserted as UFW rules (visible with: ufw status)
banaction = ufw

[sshd]
enabled = true
port    = ssh
backend = auto
logpath = /var/log/auth.log
